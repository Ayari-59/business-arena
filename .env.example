# Connexion applicative (endpoint POOLER Neon — utilisé par l'app et le driver HTTP)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Connexion directe (endpoint SANS -pooler — utilisé par drizzle-kit pour les migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Secret de session (générer : openssl rand -base64 32)
AUTH_SECRET=""
# Secret du cron Vercel (clôture des tours à échéance)
CRON_SECRET=""
# Admins généraux de la plateforme (e-mails séparés par des virgules) :
# promus automatiquement à la connexion/inscription
ADMIN_EMAILS=""
# Courriel de notification des demandes de simulation (page /orientation).
# Facultatif : sans clé, la demande est enregistrée et lue dans l'administration,
# aucun courriel ne part. Clé d'API Resend (https://resend.com) et expéditeur
# (domaine vérifié chez Resend).
RESEND_API_KEY=""
MAIL_FROM="Business Arena <contact@business-arena.fr>"
# Rendez-vous téléphoniques (page /rendez-vous) : les créneaux se règlent sur un
# agenda Google et le rendez-vous y est posé. Facultatif : sans ces valeurs, la
# page propose les plages ouvertes (src/config/rendez-vous.ts) moins les
# réservations déjà prises.
# Le client OAuth se crée dans la console Google (type « Application Web », URI
# de redirection autorisée : https://www.business-arena.fr/api/google/callback) ;
# ses deux valeurs vont ici. La connexion du compte se fait ensuite d'un clic
# dans l'administration (« Connecter mon agenda Google ») : le jeton est gardé
# chiffré en base, rien d'autre à copier.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facultatif : un jeton posé ici l'emporte sur la connexion faite dans
# l'administration (obtenu par scripts/google-agenda-autorisation.mjs, client
# de type « Application de bureau »).
GOOGLE_REFRESH_TOKEN=""
# L'agenda où poser les rendez-vous (« primary » = l'agenda principal du compte).
GOOGLE_CALENDAR_ID="primary"
# Les agendas dont l'occupation compte, séparés par des virgules ; vide = tous
# les agendas du compte, emplois du temps importés compris.
GOOGLE_BUSY_CALENDARS=""
# LTI 1.3 (Moodle, Canvas, Blackboard, Brightspace) : la clé privée RSA de l'outil, en
# PEM. Générer avec `npx tsx scripts/lti-cle.mts` ; ne JAMAIS la commiter. Sans elle, en
# production, les routes /api/lti/* répondent 503 ; en développement, une clé
# éphémère est tirée au démarrage.
LTI_PRIVATE_KEY=""
# Rotation : les clés PUBLIQUES précédentes (PEM à la suite), encore publiées dans le JWKS.
LTI_PREVIOUS_PUBLIC_KEYS=""
# Connexion par l'établissement (SAML 2.0, Fédération Éducation-Recherche de RENATER).
# Clé privée RSA et certificat auto-signé du fournisseur de services, en PEM : générer
# avec `npx tsx scripts/saml-cle.mts` (écrit hors du dépôt) ; ne JAMAIS les commiter.
# Sans eux ou sans l'épingle de l'agrégat, les routes /api/saml/* répondent 503 et le
# bouton « Se connecter avec mon établissement » n'apparaît pas.
SAML_SP_PRIVATE_KEY=""
SAML_SP_CERT=""
# « test » (fédération de test de RENATER, par défaut) ou « production ».
SAML_FEDERATION="test"
# Empreinte SHA-256 du certificat qui signe les métadonnées de RENATER (épingle), ou le
# certificat lui-même (PEM) dans SAML_FEDERATION_CERT.
SAML_FEDERATION_CERT_SHA256=""
SAML_FEDERATION_CERT=""
# Facultatifs : remplacent les adresses documentées (src/saml/constantes.ts).
SAML_FEDERATION_METADATA_URL=""
SAML_WAYF_URL=""
